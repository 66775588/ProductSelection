# ===== 智谱 GLM 大模型 =====
ZHIPUAI_API_KEY=your_zhipuai_api_key_here
GLM_MODEL=glm-4.6

# ===== 选品评分与利润阈值 =====
# 毛利率低于此值（%）标记风险
PROFIT_THRESHOLD=30
# 综合得分阈值：>=80 强烈推荐，>=65 可尝试，>=50 谨慎进入，<50 不推荐
SCORE_STRONG_RECOMMEND=80
SCORE_TRY=65
SCORE_CAUTIOUS=50

# ===== 爬取参数 =====
CRAWL_TIMEOUT=30
CRAWL_CONCURRENCY=3
CRAWL_HEADLESS=true
# 关闭后所有数据源强制走 Mock（断网/演示用）
FORCE_MOCK=false

# ===== 数据路径 =====
DATA_DIR=./data
REPORTS_DIR=./data/reports
MEMORY_DB=./data/memory.db
